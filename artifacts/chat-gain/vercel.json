{
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && PORT=3000 BASE_PATH=/ pnpm --filter @workspace/chat-gain run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}